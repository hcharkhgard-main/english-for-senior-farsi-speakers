{
  "name": "hamrah-english",
  "version": "0.1.0",
  "description": "Hamrah — a Farsi-first English companion for older immigrants. Static, installable, works offline.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node tools/build.mjs",
    "site:check": "node tools/build.mjs --check",
    "serve": "node tools/serve.mjs site 8080",
    "validate": "node tools/validate-content.mjs",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:layout": "node tests/e2e/overflow.mjs",
    "test:shell": "node tests/e2e/shell.mjs",
    "test:offline": "node tests/e2e/offline.mjs",
    "test:path": "node tests/e2e/path.mjs",
    "test:papers": "node tests/e2e/papers.mjs",
    "audio:collect": "node tools/collect-audio.mjs",
    "audio:generate": "python3 tools/gen_audio.py",
    "audio:pack": "node tools/pack-audio.mjs",
    "review:export": "node tools/export-review.mjs",
    "review:check": "node tools/export-review.mjs --check",
    "personas": "node tools/make-personas.mjs"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.2.8",
    "esbuild": "^0.28.2",
    "onnxruntime-web": "^1.22.0",
    "playwright": "1.56.0",
    "vazirmatn": "^33.0.3"
  }
}
